<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ImageWatermarkPortable</RootNamespace>
    <AssemblyName>ImageWatermarkPortable</AssemblyName>
    <Version>1.0.0</Version>
    <InformationalVersion>1.0.$([System.DateTime]::Now.ToString("yyMMddHHss"))</InformationalVersion>
    <Product>Image Watermark Portable</Product>
    <AssemblyTitle>Image Watermark Portable</AssemblyTitle>
    <ApplicationIcon>..\..\assets\icon.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en;zh-Hant</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ImageWatermarkPortable.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="2.1.5" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\sample1.jpg" LogicalName="ImageWatermarkPortable.sample1.jpg" />
    <EmbeddedResource Include="..\..\assets\icon.ico" LogicalName="ImageWatermarkPortable.icon.ico" />
  </ItemGroup>

</Project>
